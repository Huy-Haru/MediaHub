generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId   String    @unique @map("auth_user_id") @db.Uuid
  role         String    @default("CUSTOMER")
  fullName     String    @map("full_name")
  email        String
  avatarUrl    String?   @map("avatar_url")
  phone        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")
  customer     Customer?
  uploadedFiles ProjectFile[] @relation("UploadedFiles")
  createdHistory ProjectStatusHistory[] @relation("CreatedHistory")
  notifications Notification[]

  @@map("profiles")
}

model Customer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId      String    @unique @map("profile_id") @db.Uuid
  companyName    String?   @map("company_name")
  industry       String?
  address        String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @map("updated_at")
  profile        Profile   @relation(fields: [profileId], references: [id])
  projects       Project[]
  revisions      RevisionRequest[]
  reviews        Review[]
  invoices       Invoice[]

  @@map("customers")
}

model Employee {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  email      String
  phone      String?
  position   String?
  department String?
  skills     String[]  @default([])
  status     String?   @default("ACTIVE")
  joinedAt   DateTime? @db.Date @map("joined_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @map("updated_at")

  @@map("employees")
}

model Service {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String           @unique
  description    String?
  category       String?
  startingPrice  Decimal?         @map("starting_price") @db.Decimal(16, 2)
  estimatedDays  Int?             @map("estimated_days")
  thumbnailUrl   String?          @map("thumbnail_url")
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @map("updated_at")
  projectServices ProjectService[]
  quotationItems QuotationItem[]

  @@map("services")
}

model Project {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId     String                @map("customer_id") @db.Uuid
  title          String
  description    String
  category       String?
  budget         Decimal?              @db.Decimal(16, 2)
  deadline       DateTime?             @db.Date
  status         String                @default("SUBMITTED")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @default(now()) @map("updated_at")
  customer       Customer              @relation(fields: [customerId], references: [id])
  services       ProjectService[]
  quotations     Quotation[]
  files          ProjectFile[]
  statusHistory  ProjectStatusHistory[]
  deliverables   Deliverable[]
  revisions      RevisionRequest[]
  review         Review?
  invoice        Invoice?

  @@index([customerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("projects")
}

model ProjectService {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  quantity  Int     @default(1)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id])

  @@unique([projectId, serviceId])
  @@map("project_services")
}

model Quotation {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  subtotal    Decimal         @db.Decimal(16, 2)
  discount    Decimal         @default(0) @db.Decimal(16, 2)
  total       Decimal         @db.Decimal(16, 2)
  validUntil  DateTime        @db.Date @map("valid_until")
  status      String
  notes       String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @map("updated_at")
  project     Project         @relation(fields: [projectId], references: [id])
  items       QuotationItem[]

  @@map("quotations")
}

model QuotationItem {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId String     @map("quotation_id") @db.Uuid
  serviceId   String?    @map("service_id") @db.Uuid
  description String
  quantity    Int
  unitPrice   Decimal    @map("unit_price") @db.Decimal(16, 2)
  total       Decimal    @db.Decimal(16, 2)
  quotation   Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  service     Service?   @relation(fields: [serviceId], references: [id])

  @@map("quotation_items")
}

model ProjectFile {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  uploadedBy String   @map("uploaded_by") @db.Uuid
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  fileType   String   @map("file_type")
  fileSize   BigInt   @map("file_size")
  createdAt  DateTime @default(now()) @map("created_at")
  project    Project  @relation(fields: [projectId], references: [id])
  uploader   Profile  @relation("UploadedFiles", fields: [uploadedBy], references: [id])

  @@map("project_files")
}

model ProjectStatusHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  status    String
  note      String?
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id])
  creator   Profile? @relation("CreatedHistory", fields: [createdBy], references: [id])

  @@map("project_status_history")
}

model Deliverable {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  fileUrl   String   @map("file_url")
  version   Int      @default(1)
  status    String   @default("PENDING_APPROVAL")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id])

  @@map("deliverables")
}

model RevisionRequest {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  description  String
  attachmentUrl String? @map("attachment_url")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")
  project      Project  @relation(fields: [projectId], references: [id])
  customer     Customer @relation(fields: [customerId], references: [id])

  @@map("revision_requests")
}

model Review {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId           String   @unique @map("project_id") @db.Uuid
  customerId          String   @map("customer_id") @db.Uuid
  rating              Int
  qualityRating       Int      @map("quality_rating")
  communicationRating Int      @map("communication_rating")
  valueRating         Int      @map("value_rating")
  comment             String
  createdAt           DateTime @default(now()) @map("created_at")
  project             Project  @relation(fields: [projectId], references: [id])
  customer            Customer @relation(fields: [customerId], references: [id])
  testimonial         Testimonial?

  @@map("reviews")
}

model Testimonial {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId    String    @unique @map("review_id") @db.Uuid
  content     String
  status      String    @default("PENDING")
  publishedAt DateTime? @map("published_at")
  review      Review    @relation(fields: [reviewId], references: [id])

  @@map("testimonials")
}

model Invoice {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String    @unique @map("project_id") @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  invoiceNumber String    @unique @map("invoice_number")
  amount        Decimal   @db.Decimal(16, 2)
  status        String    @default("PENDING")
  issuedAt      DateTime  @default(now()) @map("issued_at")
  paidAt        DateTime? @map("paid_at")
  project       Project   @relation(fields: [projectId], references: [id])
  customer      Customer  @relation(fields: [customerId], references: [id])

  @@map("invoices")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  message   String
  type      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      Profile   @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Portfolio {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  client      String
  description String?
  category    String?
  imageUrl    String?  @map("image_url")
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("portfolio")
}
